GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
PEXELS_API_KEY=
# TTS: pt-BR-AntonioNeural (masc) ou pt-BR-FranciscaNeural (fem)
TTS_VOICE=pt-BR-AntonioNeural
TTS_RATE=+0%
# Whisper: base = ~500MB RAM int8 cpu. Use tiny se <4GB livre.
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
# Upload via API: client_secrets.json (OAuth Desktop) + token_youtube.pickle
# Escopos: youtube.upload + youtube.readonly + yt-analytics.readonly

